{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDevClaw",
  "version": "0.2.3",
  "identifier": "dev.agentdev.claw",
  "build": {},
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
