{
  "id": "memo",
  "kind": "workspace",
  "threadHost": true,
  "name": "Memo 智能备忘录",
  "description": "随聊随记的备忘与提醒应用（对话已就绪，提醒能力建设中）",
  "version": "0.2.0",
  "icon": "note",
  "category": "productivity",
  "enabled": true,
  "visibility": "persistent",
  "sidebarGroup": "tool",
  "features": [],
  "ui": {
    "entry": "home",
    "tabs": [
      {
        "id": "home",
        "label": {
          "zh": "首页",
          "en": "Home"
        }
      }
    ],
    "home": {
      "blocks": [
        {
          "id": "hero",
          "type": "hero",
          "variant": "bar",
          "kicker": {
            "zh": "工具与效率",
            "en": "Tools & Efficiency"
          },
          "title": {
            "zh": "Memo",
            "en": "Memo"
          },
          "body": {
            "zh": "随时说一句就记下，到点它会主动找你。",
            "en": "Jot by chatting; it reaches out when it's time."
          },
          "actions": [
            {
              "label": {
                "zh": "打开对话",
                "en": "Open Conversation"
              },
              "action": {
                "type": "start_app_conversation",
                "endpoint": "/protoclaw/memo-app/conversation/start"
              }
            },
            {
              "label": {
                "zh": "新建对话",
                "en": "New Conversation"
              },
              "className": "workspace-action secondary",
              "action": {
                "type": "start_app_conversation",
                "endpoint": "/protoclaw/memo-app/conversation/new"
              }
            },
            {
              "label": {
                "zh": "设置",
                "en": "Settings"
              },
              "className": "workspace-action secondary",
              "action": {
                "type": "open_app_settings",
                "settings": "memo"
              }
            }
          ]
        },
        {
          "id": "memo-notes",
          "type": "memo-notes"
        },
        {
          "id": "chat-input",
          "type": "app-chat-input",
          "resolveEndpoint": "/protoclaw/memo-app/state",
          "ensureEndpoint": "/protoclaw/memo-app/conversation/start",
          "placeholder": {
            "zh": "跟 Memo 说一句，随手记下…",
            "en": "Tell Memo something to jot down…"
          }
        }
      ]
    }
  }
}
