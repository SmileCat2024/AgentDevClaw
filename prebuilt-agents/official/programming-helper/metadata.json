{
  "id": "programming-helper",
  "kind": "agent",
  "name": "智能编码空间",
  "description": "面向真实编码任务的编程工作空间，支持理解代码、实现功能、排障和重构",
  "version": "2.0.0",
  "icon": "code",
  "category": "development",
  "processMode": "shared-by-project",
  "enabled": true,
  "features": [
    "todo",
    "force-continuation",
    "audio-feedback",
    "user-input",
    "websearch",
    "memory",
    "shell",
    "context-guard",
    "mcp",
    "skill",
    "stylized-output"
  ],
  "identities": [
    {
      "id": "main",
      "displayName": "编程小助手",
      "description": "擅长编码、调试、重构，支持完整工具链",
      "sessionModel": "persistent",
      "qualifierLabel": "项目",
      "groupChat": true,
      "operations": [
        "status",
        "sessions",
        "send",
        "interrupt",
        "create",
        "overview"
      ]
    }
  ],
  "ui": {
    "entry": "sessions",
    "tabs": [
      {
        "id": "sessions",
        "label": {
          "zh": "项目",
          "en": "Projects"
        }
      },
      {
        "id": "chat",
        "label": {
          "zh": "对话",
          "en": "Chat"
        }
      }
    ],
    "home": {
      "blocks": [
        {
          "id": "coder-entry",
          "type": "coder-entry",
          "visibility": "tab:sessions",
          "title": {
            "zh": "Coder 工作线程",
            "en": "Coder Threads"
          },
          "description": {
            "zh": "无人值守自主编码智能体：线程由调度面创建（ACP / claw threads / dispatch），在独立工作空间执行。",
            "en": "Unattended autonomous coding agent: threads are created by the dispatch plane (ACP / claw threads / dispatch) and run in their own workspace."
          }
        },
        {
          "id": "session-list",
          "type": "session-list",
          "visibility": "tab:sessions",
          "title": {
            "zh": "项目记录",
            "en": "Project Sessions"
          },
          "description": {
            "zh": "继续之前的对话，或开始一段新的编码会话。",
            "en": "Resume a prior conversation or start a new coding session."
          },
          "headerAction": {
            "label": {
              "zh": "新对话",
              "en": "New Chat"
            },
            "action": {
              "type": "create_session",
              "openDirectory": ""
            }
          }
        }
      ]
    }
  }
}
