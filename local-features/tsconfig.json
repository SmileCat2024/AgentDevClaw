{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist"
  },
  "include": [
    "./index.ts",
    "./context-compaction-control/src/**/*.ts",
    "./context-guard/src/**/*.ts",
    "./context-guard/test/**/*.ts",
    "./context-compaction-mirror/src/**/*.ts",
    "./context-compaction-mirror/test/**/*.ts",
    "./feature-dev/src/**/*.ts",
    "./agent-dev/src/**/*.ts",
    "./agent-studio/src/**/*.ts",
    "./agent-studio/test/**/*.ts",
    "./flow/src/**/*.ts",
    "./flow/test/**/*.ts",
    "./dispatch/src/**/*.ts",
    "./dispatch/test/**/*.ts",
    "./conversation-export/src/**/*.ts",
    "./checkpoint/src/**/*.ts",
    "./checkpoint/test/**/*.ts",
    "./continuity-participant/src/**/*.ts",
    "./continuity-participant/test/**/*.ts",
    "./feature-wrappers/src/**/*.ts",
    "./feature-wrappers/test/**/*.ts",
    "./group-admin/src/**/*.ts",
    "./group-admin/test/**/*.ts",
    "./generative-ui/src/**/*.ts",
    "./generative-ui/test/**/*.ts",
    "./github/src/**/*.ts"
  ]
}
