{
  "name": "agentdevclaw",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "A visual, extensible AI agent workspace powered by AgentDev.",
  "scripts": {
    "build:local-features": "tsc -p local-features/tsconfig.json && node scripts/copy-local-feature-skills.mjs",
    "check:agentdev": "node scripts/check-agentdev-local.mjs",
    "build:features": "node scripts/build-features.mjs",
    "pack:features": "node scripts/pack-features.mjs",
    "enrich:features": "node scripts/enrich-feature-packages.mjs",
    "predev": "node scripts/preflight.mjs",
    "dev": "node server.js",
    "prestart": "node scripts/preflight.mjs",
    "start": "node server.js",
    "agentdev:local": "node scripts/use-agentdev-local.mjs",
    "agentdev:published": "node scripts/use-agentdev-published.mjs",
    "test": "npm run test:core && npm run test:features",
    "test:core": "node --test test/*.test.js",
    "test:file": "node --test",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "test:features": "node --test \"local-features/dist/*/test/*.test.js\"",
    "pretest:features": "npm run build:local-features",
    "lint": "eslint .",
    "adv-docs:sync": "node scripts/sync-adv-docs.mjs",
    "build": "node scripts/build-all.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@agentdevjs/audio-feedback-feature": "^0.1.0",
    "@agentdevjs/audit-feature": "^0.1.0",
    "@agentdevjs/create-feature": "^0.1.0",
    "@agentdevjs/core": "^0.1.0",
    "@agentdevjs/feishu-bot": "^0.1.0",
    "@agentdevjs/image-reader-feature": "^0.1.0",
    "@agentdevjs/llm": "^0.1.0",
    "@agentdevjs/mcp": "^0.1.0",
    "@agentdevjs/memory-feature": "^0.1.0",
    "@agentdevjs/plugin-compat-feature": "^0.1.0",
    "@agentdevjs/qqbot-feature": "^0.1.0",
    "@agentdevjs/rokid-bot": "^0.1.0",
    "@agentdevjs/shell-feature": "^0.1.0",
    "@agentdevjs/tts-feature": "^0.1.0",
    "@agentdevjs/viewer": "^0.1.0",
    "@agentdevjs/visual-feature": "^0.1.0",
    "@agentdevjs/websearch-feature": "^0.1.0",
    "@agentdevjs/wecom-bot": "^0.1.0",
    "@agentdevjs/weixin-bot": "^0.1.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.21.2",
    "marked": "^18.0.4",
    "multer": "^2.1.1",
    "openai": "^6.45.0",
    "typescript": "^5.3.3",
    "undici": "^7.25.0",
    "zod": "^4.4.3"
  },
  "bin": {
    "claw": "./bin/claw.mjs",
    "advclaw": "./bin/advclaw.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
