{
  "id": "programming-helper",
  "kind": "agent",
  "name": "智能编码空间",
  "description": "面向真实编码任务的编程工作空间，支持理解代码、实现功能、排障和重构",
  "version": "2.0.0",
  "icon": "code",
  "category": "development",
  "processMode": "shared-by-project",
  "enabled": true,
  "features": [
    "todo",
    "force-continuation",
    "audit",
    "audio-feedback",
    "user-input",
    "websearch",
    "memory",
    "shell",
    "lsp",
    "context-guard",
    "mcp",
    "skill",
    "step-rotating-model"
  ],
  "identities": [
    {
      "id": "main",
      "displayName": "编程小助手",
      "description": "擅长编码、调试、重构，支持完整工具链",
      "sessionModel": "persistent",
      "qualifierLabel": "项目",
      "groupChat": true,
      "operations": [
        "status",
        "sessions",
        "send",
        "interrupt",
        "create",
        "overview"
      ]
    },
    {
      "id": "coder",
      "displayName": "Coder",
      "description": "自主编码智能体：线程化无人值守执行，会话由调度面（ACP / threads CLI / dispatch）创建，不接受用户直接创建",
      "sessionModel": "persistent",
      "sessionType": "coder",
      "qualifierLabel": "项目",
      "sidebarEntry": true,
      "sidebarGroup": "tool",
      "operations": [
        "status",
        "sessions",
        "interrupt",
        "overview"
      ],
      "ui": {
        "entry": "sessions",
        "tabs": [
          {
            "id": "sessions",
            "label": {
              "zh": "线程",
              "en": "Threads"
            }
          },
          {
            "id": "chat",
            "label": {
              "zh": "对话",
              "en": "Chat"
            }
          }
        ],
        "home": {
          "blocks": [
            {
              "id": "coder-threads",
              "type": "coder-threads",
              "visibility": "tab:sessions"
            }
          ]
        }
      }
    }
  ],
  "ui": {
    "entry": "sessions",
    "tabs": [
      {
        "id": "sessions",
        "label": {
          "zh": "项目",
          "en": "Projects"
        }
      },
      {
        "id": "chat",
        "label": {
          "zh": "对话",
          "en": "Chat"
        }
      }
    ],
    "home": {
      "blocks": [
        {
          "id": "session-list",
          "type": "session-list",
          "visibility": "tab:sessions",
          "title": {
            "zh": "项目记录",
            "en": "Project Sessions"
          },
          "description": {
            "zh": "继续之前的对话，或开始一段新的编码会话。",
            "en": "Resume a prior conversation or start a new coding session."
          },
          "headerAction": {
            "label": {
              "zh": "新对话",
              "en": "New Chat"
            },
            "action": {
              "type": "create_session",
              "openDirectory": ""
            }
          }
        }
      ]
    }
  }
}