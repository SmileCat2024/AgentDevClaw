{
  "name": "agentdevclaw",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "A visual, extensible AI agent workspace powered by AgentDev.",
  "scripts": {
    "build:local-features": "tsc -p local-features/tsconfig.json && node scripts/copy-local-feature-skills.mjs",
    "check:agentdev": "node scripts/check-agentdev-local.mjs",
    "build:features": "node scripts/build-features.mjs",
    "pack:features": "node scripts/pack-features.mjs",
    "enrich:features": "node scripts/enrich-feature-packages.mjs",
    "predev": "node scripts/preflight.mjs",
    "dev": "node server.js",
    "prestart": "node scripts/preflight.mjs",
    "start": "node server.js",
    "agentdev:local": "node scripts/use-agentdev-local.mjs",
    "agentdev:published": "node scripts/use-agentdev-published.mjs",
    "test": "npm run test:core && npm run test:features",
    "test:core": "node --test test/*.test.js",
    "test:file": "node --test",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "test:features": "node --test \"local-features/dist/*/test/*.test.js\"",
    "pretest:features": "npm run build:local-features",
    "lint": "eslint .",
    "adv-docs:sync": "node scripts/sync-adv-docs.mjs",
    "build": "node scripts/build-all.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@agentdevjs/audio-feedback-feature": "file:../AgentDev/packages/audio-feedback-feature",
    "@agentdevjs/audit-feature": "file:../AgentDev/packages/audit-feature",
    "@agentdevjs/core": "file:../AgentDev/packages/core",
    "@agentdevjs/feishu-bot": "file:../AgentDev/packages/feishu-bot",
    "@agentdevjs/image-reader-feature": "file:../AgentDev/packages/image-reader-feature",
    "@agentdevjs/llm": "file:../AgentDev/packages/llm",
    "@agentdevjs/mcp": "file:../AgentDev/packages/mcp",
    "@agentdevjs/memory-feature": "file:../AgentDev/packages/memory-feature",
    "@agentdevjs/plugin-compat-feature": "file:../AgentDev/packages/plugin-compat-feature",
    "@agentdevjs/qqbot-feature": "file:../AgentDev/packages/qqbot-feature",
    "@agentdevjs/rokid-bot": "file:../AgentDev/packages/rokid-feature",
    "@agentdevjs/shell-feature": "file:../AgentDev/packages/shell-feature",
    "@agentdevjs/tts-feature": "file:../AgentDev/packages/tts-feature",
    "@agentdevjs/viewer": "file:../AgentDev/packages/viewer",
    "@agentdevjs/visual-feature": "file:../AgentDev/packages/visual-feature",
    "@agentdevjs/websearch-feature": "file:../AgentDev/packages/websearch-feature",
    "@agentdevjs/wecom-bot": "file:../AgentDev/packages/wecom-bot",
    "@agentdevjs/weixin-bot": "file:../AgentDev/packages/weixin-bot",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.21.2",
    "marked": "^18.0.4",
    "multer": "^2.1.1",
    "openai": "^6.45.0",
    "typescript": "^5.3.3",
    "undici": "^7.25.0",
    "zod": "^4.4.3"
  },
  "bin": {
    "claw": "./bin/claw.mjs",
    "advclaw": "./bin/advclaw.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
