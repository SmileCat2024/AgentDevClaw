  "tests": [
    {
      "id": "observe-step-and-finish",
      "title": "强制继续 Feature 观察 step 与 call 终态",
      "input": "请仅回复 READY，不调用工具。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "hook-observed",
          "lifecycle": "StepFinish",
          "feature": "force-continuation",
          "method": "decideContinuation"
        },
        {
          "kind": "hook-observed",
          "lifecycle": "CallFinish",
          "feature": "force-continuation",
          "method": "recordCallFinish"
        },
        {
          "kind": "reply-includes",
          "text": "READY"
        }
      ],
      "enabled": true,
      "createdAt": "2026-08-19T04:28:43.129Z",
      "updatedAt": "2026-08-19T04:28:43.129Z",
      "description": "在默认关闭状态下，确认 Feature 的 StepFinish 与 CallFinish 钩子均真实接收到一次正常 call 的生命周期。"
    },
    {
      "id": "status-tool-and-lifecycle",
      "title": "强制继续为纯自动策略（无工具暴露）",
      "input": "请仅回复 DONE。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "hook-observed",
          "lifecycle": "StepFinish",
          "feature": "force-continuation",
          "method": "decideContinuation"
        },
        {
          "kind": "hook-observed",
          "lifecycle": "CallFinish",
          "feature": "force-continuation",
          "method": "recordCallFinish"
        },
        {
          "kind": "reply-includes",
          "text": "DONE"
        }
      ],
      "enabled": true,
      "createdAt": "2026-08-19T04:35:42.297Z",
      "updatedAt": "2026-08-19T06:05:47.493Z",
      "description": "移除 force_continuation_status 工具后，Feature 成为纯自动策略：钩子照常触发，且不再向 Agent 暴露任何可调用工具。"
    },
    {
      "id": "tickets-flow-list-skills",
      "title": "票据构建流程规范清单（harness 无 SkillFeature 时的便携入口）",
      "input": "我准备开始按工单做事了。请调用 tickets_flow_skill 工具（不带参数）查看 tickets-build-flow 提供的流程规范清单，然后告诉我一共有哪几个规范、各自适用什么场景。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "tool-executed",
          "tool": "tickets_flow_skill"
        },
        {
          "kind": "tool-result-path",
          "tool": "tickets_flow_skill",
          "path": "$.count",
          "equals": 3
        },
        {
          "kind": "reply-includes",
          "text": "implement"
        }
      ],
      "enabled": true,
      "createdAt": "2026-08-20T04:27:35.967Z",
      "updatedAt": "2026-08-20T04:27:35.967Z"
    },
    {
      "id": "tickets-flow-read-tdd",
      "title": "读取 tdd 规范全文（SKILL.md 从构建产物分发）",
      "input": "请调用 tickets_flow_skill 工具，参数 skill=tdd，读取 TDD 规范全文，然后用中文总结它的循环规则。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "tool-executed",
          "tool": "tickets_flow_skill"
        },
        {
          "kind": "tool-result-path",
          "tool": "tickets_flow_skill",
          "path": "$.skill",
          "equals": "tdd"
        },
        {
          "kind": "reply-includes",
          "text": "red"
        }
      ],
      "enabled": true,
      "createdAt": "2026-08-20T04:27:39.097Z",
      "updatedAt": "2026-08-20T04:27:39.097Z"
    },
    {
      "id": "rotation-phase-observed",
      "title": "模型轮转 Feature 观察 call 与 step 相位推进",
      "input": "请调用 tickets_flow_skill 工具，参数 skill=tdd，读取 TDD 规范全文，然后用一句话概括 red 阶段要做什么。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "hook-observed",
          "lifecycle": "CallStart",
          "feature": "step-rotating-model",
          "method": "onCallStart"
        },
        {
          "kind": "hook-observed",
          "lifecycle": "StepStart",
          "feature": "step-rotating-model",
          "method": "onStepStart"
        },
        {
          "kind": "tool-executed",
          "tool": "tickets_flow_skill"
        }
      ],
      "enabled": true,
      "createdAt": "2026-08-26T13:05:22.982Z",
      "updatedAt": "2026-08-26T13:07:17.813Z",
      "description": "验证轮转 Feature 挂载与相位逻辑执行：CallStart 观察钩子触发；StepStart 至少 2 次（工具 step + 总结 step，多步场景相位推进）；tickets_flow_skill 真实执行构造多 step 前提。零工具 Feature：切换真实性由 ADR-0009 框架回归测试背书，本断言锁定钩子证据归属。"
    },
    {
      "id": "style-gate-signed-finish",
      "title": "签名门禁：未启用风格时签名调用被明确拒绝",
      "input": "请调用 sign_output_style 工具，参数 signature 填「测试签名」，然后告诉我调用结果是什么。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "tool-executed",
          "tool": "sign_output_style"
        },
        {
          "kind": "tool-result-path",
          "tool": "sign_output_style",
          "path": "$.ok",
          "equals": false
        },
        {
          "kind": "reply-includes",
          "text": "未启用"
        }
      ],
      "enabled": true,
      "createdAt": "2026-10-06T14:10:07.021Z",
      "updatedAt": "2026-10-07T03:55:37.529Z",
      "description": "风格启用入口收敛到面板 capability 后，Runtime 无法自动启用风格；原「正确默写签名放行」正向场景改为可自动化的未启用分支：新会话调用签名工具得到明确的「无需签名」拒绝（ok=false），不产生副作用。正向门禁路径回归以面板人工验证为准。"
    },
    {
      "id": "style-gate-forces-sign",
      "title": "签名门禁：跨会话重置——新会话不携带任何风格选择",
      "input": "请调用 list_output_styles 工具查看当前风格状态，然后告诉我当前启用了哪个输出风格。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "tool-executed",
          "tool": "list_output_styles"
        },
        {
          "kind": "tool-result-path",
          "tool": "list_output_styles",
          "path": "$.activeStyle",
          "equals": null
        },
        {
          "kind": "reply-includes",
          "text": "未启用"
        }
      ],
      "enabled": true,
      "createdAt": "2026-10-06T14:10:07.032Z",
      "updatedAt": "2026-10-07T03:55:37.541Z",
      "description": "风格选择改为会话内存态后，「任何对话都继承目录里上一个会话的选择」的问题必须杜绝：fresh 新会话查询风格状态，activeStyle 必须为 null（未选择），门禁旁路。原「禁止工具仍强制补签」场景依赖风格已启用，启用入口只剩面板链路，无法在 Runtime 自动化，回归以面板人工验证为准。"
    },
    {
      "id": "style-gate-bypass-when-unset",
      "title": "签名门禁：未选择风格时旁路放行",
      "input": "用一句话打个招呼。",
      "sessionPolicy": "fresh",
      "assertions": [
        {
          "kind": "hook-observed",
          "lifecycle": "StepFinish",
          "feature": "stylized-output",
          "method": "decideSignatureGate"
        }
      ],
      "enabled": true,
      "createdAt": "2026-10-06T14:10:07.039Z",
      "updatedAt": "2026-10-07T03:55:37.517Z",
      "description": "新会话内存初始未选择任何风格（无磁盘选择文件可继承）：门禁钩子照常触发并旁路放行，回复正常交付，无死锁。原「.current-style 清空」前置随文件存储移除而取消。"
    }
  ],
