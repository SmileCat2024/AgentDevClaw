{
  "id": "agent-studio",
  "kind": "agent",
  "name": "Agent Studio",
  "description": "开发与验证 Feature，产物统一收进本机 Feature 仓库",
  "version": "0.1.0",
  "icon": "bot",
  "category": "development",
  "sortOrder": 30,
  "enabled": true,
  "features": [
    "todo",
    "force-continuation",
    "websearch",
    "shell",
    "agent-studio",
    "user-input",
    "mcp",
    "skill",
    "subagent"
  ],
  "ui": {
    "entry": "home",
    "home": {
      "blocks": [
        {
          "id": "hero",
          "type": "hero",
          "title": { "zh": "Agent Studio", "en": "Agent Studio" },
          "kicker": { "zh": "Agent 工作空间", "en": "Agent Workspace" },
          "body": {
            "zh": "一个个 Feature 就是一条条开发线：对话里开发、验证、快照，产物统一收进本机 Feature 仓库。",
            "en": "Each feature is a development thread: develop, verify and snapshot in conversation; artifacts are collected into the local feature repository."
          },
          "actions": [
            {
              "label": { "zh": "新建对话", "en": "New conversation" },
              "action": { "type": "create_session" }
            },
            {
              "label": { "zh": "导入 tgz", "en": "Import tgz" },
              "action": { "type": "open_feature_upload" }
            }
          ]
        },
        {
          "id": "studio-features",
          "type": "studio-features",
          "visibility": "home-default"
        },
        {
          "id": "studio-repository",
          "type": "studio-repository",
          "visibility": "tab:repository",
          "featureRepository": { "userOnly": true }
        }
      ]
    }
  }
}
